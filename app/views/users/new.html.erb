<div class="column">
	Sign Up
	<br>
	<br>
	<div >
		<%= form_for :user, url: '/users', class: 'column' do |f| %>
			<label>Email</label>
			<%= f.text_field :email%>
			<br>
			<label>Password</label>
			<%= f.password_field :password %>
			<br>
			<label>Confirm password</label>
			<%=f.password_field :password_confirmation %>
			<br>
			<br>
			<%= f.submit %>
		<%end%>
	</div>
</div>
