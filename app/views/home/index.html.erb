<div class="container">

	<% if current_user %>
		<%if @lists.any? %>
  			<%= render @lists  %>
  		<%else  %>
  			<h3>No lists have been generatd yet, please start one</h3>
  			<%=  link_to 'New List', new_list_path, class: 'btn btn-secondary'%>
  		<% end %>
  	<% else %>
  		<h1>Welcome</h1>
  		<h3>Please log in to start using the list program</h3>
  	<% end %>
</div>