<div id="<%= dom_id item %>">
  <div>
    <strong>List:</strong>
    <%= item.list_id %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= item.name %>
  </div>

  <div>
    <strong>Owned:</strong>
    <%= item.owned %>
  </div>

  <div>
    <strong>Condition:</strong>
    <%= item.condition %>
  </div>

  <div>
    <strong>Rating:</strong>
    <%= item.rating %>
  </div>

</div>
