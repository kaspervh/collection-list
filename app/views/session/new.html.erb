<div class="column">

	<h1>Login</h1>
	<br>
	<%= form_with(url: session_create_path, method: :post, local: true) do |form|%>
		<div class="column">
			<%= form.text_field :email, placeholder: "email" %>
			<br>
			<%= form.password_field :password, placeholder: "password"%>
			<br>
			<%= form.submit "Login"%>
		</div>
	<% end %>
</div>